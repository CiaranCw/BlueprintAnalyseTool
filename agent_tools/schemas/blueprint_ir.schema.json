{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://blueprint-analyse-tool/schemas/blueprint_ir.schema.json",
  "title": "Aggregated Blueprint IR (manifest + graphs + nodes inlined). Used mostly for golden tests.",
  "type": "object",
  "allOf": [
    { "$ref": "blueprint_manifest.schema.json" }
  ],
  "properties": {
    "graphs_full": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["graph_id", "nodes", "edges"],
        "properties": {
          "graph_id": { "type": "string" },
          "nodes":    { "type": "array" },
          "edges":    { "type": "array" }
        }
      }
    }
  }
}
