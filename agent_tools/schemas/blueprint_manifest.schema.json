{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://blueprint-analyse-tool/schemas/blueprint_manifest.schema.json",
  "title": "Blueprint Manifest IR (top-level)",
  "type": "object",
  "required": ["schema_version", "asset", "members", "graphs", "complexity"],
  "properties": {
    "schema_version": { "type": "string" },
    "asset": {
      "type": "object",
      "required": [
        "asset_path", "package_path", "asset_name",
        "blueprint_class", "generated_class", "parent_class",
        "blueprint_type", "engine_version",
        "parse_time", "parse_status"
      ],
      "properties": {
        "asset_path":          { "type": "string" },
        "package_path":        { "type": "string" },
        "asset_name":          { "type": "string" },
        "blueprint_class":     { "type": "string" },
        "generated_class":     { "type": "string" },
        "parent_class":        { "type": "string" },
        "blueprint_type":      { "type": "string" },
        "engine_version":      { "type": "string" },
        "plugin_dependencies": { "type": "array", "items": { "type": "string" } },
        "source_fingerprint": {
          "type": "object",
          "properties": {
            "uasset_size":   { "type": "integer" },
            "uasset_mtime":  { "type": "string" },
            "uasset_sha256": { "type": "string" }
          }
        },
        "parse_time":   { "type": "string" },
        "parse_status": { "type": "string", "enum": ["success", "partial", "fatal"] },
        "warnings":     { "type": "array", "items": { "type": "object" } },
        "errors":       { "type": "array", "items": { "type": "object" } }
      }
    },
    "members": {
      "type": "object",
      "properties": {
        "variables":              { "type": "array" },
        "functions":              { "type": "array" },
        "macros":                 { "type": "array" },
        "event_dispatchers":      { "type": "array" },
        "implemented_interfaces": { "type": "array" },
        "timelines":              { "type": "array" },
        "components":             { "type": ["object", "null"] }
      }
    },
    "graphs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["graph_id", "graph_name", "graph_type", "node_count"],
        "properties": {
          "graph_id":     { "type": "string" },
          "graph_name":   { "type": "string" },
          "graph_type":   { "type": "string" },
          "graph_owner":  { "type": "string" },
          "node_count":   { "type": "integer", "minimum": 0 },
          "pin_count":    { "type": "integer", "minimum": 0 },
          "edge_count":   { "type": "integer", "minimum": 0 },
          "summary_path": { "type": "string" }
        }
      }
    },
    "complexity": {
      "type": "object",
      "properties": {
        "graph_count":     { "type": "integer", "minimum": 0 },
        "total_nodes":     { "type": "integer", "minimum": 0 },
        "total_edges":     { "type": "integer", "minimum": 0 },
        "max_graph_depth": { "type": "integer", "minimum": 0 }
      }
    },
    "reverse_generation_reservation": {
      "type": "object",
      "properties": {
        "construction_recipe":         {},
        "compile_options":             {},
        "node_creation_hints":         {},
        "pin_default_overrides":       {},
        "current_phase_writes_them":   { "type": "boolean" }
      }
    }
  }
}
