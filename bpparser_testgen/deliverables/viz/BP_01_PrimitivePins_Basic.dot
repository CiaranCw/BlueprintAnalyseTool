// BP_01_PrimitivePins_Basic - structure graph
// Edge legend: solid=exec, dashed=data, dashdot=delegate/event
digraph BP_01_PrimitivePins_Basic {
  rankdir=LR;
  labelloc="t";
  label="BP_01_PrimitivePins_Basic (EventGraph)";
  node [shape=box, style="rounded,filled", fillcolor="#eef3fb", fontname="Segoe UI"];

  subgraph cluster_primitives {
    label="Primitive Pins: Get/Set + Math (pure) + Make/Break Transform + PrintString (impure)";
    style="rounded"; color="#999999"; bgcolor="#fbfbf4";

    n1  [label="Event BeginPlay\n(K2Node_Event)", fillcolor="#ffe9c7"];
    n2  [label="Get TestInt\n(VariableGet:int)"];
    n3  [label="Add_IntInt\n(pure, B=8 default)"];
    n4  [label="Set TestInt\n(VariableSet)"];
    n5  [label="Get TestDouble\n(VariableGet:real/double)"];
    n6  [label="Multiply_DoubleDouble\n(pure, B=2.0 default)"];
    n7  [label="Get TestVector"];
    n8  [label="Get TestRotator"];
    n9  [label="Make Transform\n(pure)"];
    n10 [label="Set TestTransform"];
    n11 [label="Get TestTransform"];
    n12 [label="Break Transform\n(pure)"];
    n13 [label="Get TestInt (2)"];
    n14 [label="Conv_IntToString\n(pure)"];
    n15 [label="Concat_StrStr\n(pure, A=\"TestInt=\")"];
    n16 [label="Print String\n(impure)", fillcolor="#d8f5d8"];
  }

  // exec (solid)
  n1 -> n4  [color=black];
  n4 -> n10 [color=black];
  n10 -> n16 [color=black];

  // data (dashed)
  edge [style=dashed, color="#7a7a7a", fontsize=10];
  n2 -> n3   [label="int"];
  n3 -> n4   [label="int"];
  n5 -> n6   [label="double"];
  n7 -> n9   [label="vector"];
  n8 -> n9   [label="rotator"];
  n9 -> n10  [label="transform"];
  n11 -> n12 [label="transform"];
  n13 -> n14 [label="int"];
  n14 -> n15 [label="string"];
  n15 -> n16 [label="string"];

  // legend
  subgraph cluster_legend {
    label="Legend"; style="rounded"; color="#cccccc"; fontsize=10;
    L1 [label="exec", shape=plaintext, fillcolor=white];
    L2 [label="data", shape=plaintext, fillcolor=white];
    L1 -> L2 [style=invis];
    LA [label="A", shape=point]; LB [label="B", shape=point];
    LA -> LB [color=black, label="exec", style=solid, fontsize=9];
    LC [label="C", shape=point]; LD [label="D", shape=point];
    LC -> LD [color="#7a7a7a", label="data", style=dashed, fontsize=9];
  }
}
