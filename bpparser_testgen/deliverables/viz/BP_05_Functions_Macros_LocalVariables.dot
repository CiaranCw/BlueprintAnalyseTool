// BP_05_Functions_Macros_LocalVariables - multi-graph structure
// Edge legend: solid=exec, dashed=data
digraph BP_05_Functions_Macros_LocalVariables {
  rankdir=LR;
  labelloc="t"; label="BP_05_Functions_Macros_LocalVariables (multiple graphs)";
  node [shape=box, style="rounded,filled", fillcolor="#eef3fb", fontname="Segoe UI"];

  subgraph cluster_event {
    label="EventGraph"; style="rounded"; color="#999999"; bgcolor="#fbfbf4";
    e1 [label="Event BeginPlay", fillcolor="#ffe9c7"];
    e2 [label="ComputeScore (self call)\nBase=10,Bonus=5"];
    e3 [label="Conv_IntToString"];
    e4 [label="Print String", fillcolor="#d8f5d8"];
    e1 -> e2 [color=black]; e2 -> e4 [color=black];
    e2 -> e3 [style=dashed,color="#7a7a7a",label="Total"]; e3 -> e4 [style=dashed,color="#7a7a7a",label="string"];
  }
  subgraph cluster_cs {
    label="Function: ComputeScore (impure, local var TempSum)"; style="rounded"; color="#3a7d3a"; bgcolor="#f4fbf6";
    f1 [label="Entry\n(Base,Bonus)"]; f2 [label="Add_IntInt"]; f3 [label="Return\n(Total)"];
    f1 -> f3 [color=black];
    f1 -> f2 [style=dashed,color="#7a7a7a",label="Base/Bonus"]; f2 -> f3 [style=dashed,color="#7a7a7a",label="int"];
  }
  subgraph cluster_ns {
    label="Function: NormalizeScore (PURE)"; style="rounded"; color="#3a7d3a"; bgcolor="#f4fbf6";
    g1 [label="Entry (Raw)"]; g2 [label="Divide_DoubleDouble\nB=100.0"]; g3 [label="Return (Norm)"];
    g1 -> g2 [style=dashed,color="#7a7a7a",label="Raw"]; g2 -> g3 [style=dashed,color="#7a7a7a",label="real"];
  }
  subgraph cluster_st {
    label="Function: ComputeStats (multi in/out)"; style="rounded"; color="#3a7d3a"; bgcolor="#f4fbf6";
    h1 [label="Entry (A,B)"]; h2 [label="Add_IntInt"]; h3 [label="Multiply_IntInt"]; h4 [label="Return (Sum,Product)"];
    h1 -> h4 [color=black];
    h1 -> h2 [style=dashed,color="#7a7a7a"]; h1 -> h3 [style=dashed,color="#7a7a7a"];
    h2 -> h4 [style=dashed,color="#7a7a7a",label="Sum"]; h3 -> h4 [style=dashed,color="#7a7a7a",label="Product"];
  }
  subgraph cluster_macro {
    label="Macro: Macro_LogWithPrefix (body = manual)"; style="rounded,dashed"; color="#b08a3a"; bgcolor="#fbf8f0";
    m1 [label="Input Tunnel\n(Exec,Prefix,Message)"]; m2 [label="Output Tunnel\n(Exec)"];
    m1 -> m2 [style=dotted,color="#b08a3a",label="manual body"];
  }
}
